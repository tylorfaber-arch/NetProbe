<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetProbe</AssemblyName>
    <RootNamespace>NetProbe</RootNamespace>
    <ApplicationIcon>Assets\netprobe.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Version>2.0.3</Version>
    <Product>NetProbe</Product>
    <Description>NetProbe network tester</Description>
    <Copyright>Tylor Faber</Copyright>
    <!-- Fluent theme (ThemeMode) is still flagged experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\netprobe.ico" />
  </ItemGroup>

</Project>
